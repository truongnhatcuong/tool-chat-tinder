# AI Configuration (OpenAI-compatible endpoint)
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Database Configuration
# For MySQL: mysql+aiomysql://user:password@localhost:3306/tinder_ai
# For SQLite (local fallback): sqlite+aiosqlite:///./data/tinder_ai.db
DATABASE_URL=sqlite+aiosqlite:///./data/tinder_ai.db

# Global Safety & Mode Flags
DEBUG=true
DRY_RUN=true
GLOBAL_AUTO_REPLY=false
INSPECT_DOM=true
